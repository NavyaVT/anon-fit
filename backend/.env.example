# -------------------------------
# AnonFit backend configuration
# Copy this file to `.env` and edit the values.
# -------------------------------

APP_NAME=AnonFit API
ENVIRONMENT=development

# Console + rotating file log level (backend/logs/anonfit.log)
LOG_LEVEL=INFO

# MongoDB — this project runs on a cloud Atlas cluster (see `backend/.env`).
# Use the mongodb+srv:// connection string of your own cluster here; a local
# server (`mongodb://localhost:27017`) only works for offline development.
MONGODB_URL=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/
MONGODB_DB=anonfit

# JWT — generate a long random secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Passkeys / fingerprint sign-in (WebAuthn) ---
# Blank RP_ID derives the relying party from the browser's Origin header, which
# is what you want behind a dev tunnel whose hostname changes. Set it to your
# registrable domain in production (e.g. anonfit.example.com).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=AnonFit
# Extra origins allowed to run a ceremony, beyond CORS_ORIGINS.
# Development also accepts localhost and *.devtunnels.ms / *.app.github.dev.
WEBAUTHN_ORIGINS=

# Used only by `python -m app.utils.seed_admin` to create the first admin.
# Leave blank to be prompted interactively.
SEED_ADMIN_EMAIL=admin@anonfit.app
SEED_ADMIN_PASSWORD=
