# Optional. The default `/api` is served through the Vite dev-server proxy
# (see vite.config.ts), which forwards to http://127.0.0.1:8010.
# Keep it relative so the app also works behind a forwarded port / dev tunnel.
VITE_API_URL=/api

# Only set a full URL if the API lives on a different origin, e.g.
# VITE_API_URL=https://api.example.com/api
